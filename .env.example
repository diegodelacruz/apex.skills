# Template only. Never commit real credentials.
# Copy this file to .env in the repository root and replace every placeholder.
# .env is ignored by Git. The importer moves the profile to the operating-system keyring.

# Select the database profile to use: production or testing
DB_ENV=testing

# ── Oracle DB — testing ──────────────────────────────────────────────
DB_TESTING_USER=replace_with_test_user
DB_TESTING_PASSWORD=replace_with_test_password
DB_TESTING_HOST=replace_with_test_host
DB_TESTING_PORT=1521
DB_TESTING_SID=replace_with_test_service

# ── Oracle DB — production (fill only with explicit authorization) ───
# DB_PRODUCTION_USER=replace_with_production_user
# DB_PRODUCTION_PASSWORD=replace_with_production_password
# DB_PRODUCTION_HOST=replace_with_production_host
# DB_PRODUCTION_PORT=1521
# DB_PRODUCTION_SID=replace_with_production_service

# ── APEX App Builder — testing ───────────────────────────────────────
# These are separate from Oracle DB credentials.
# base_url: the APEX instance URL (e.g. https://apex.example.com/ords)
# workspace: the APEX workspace name
# apex_user / apex_pass: App Builder login credentials
APEX_TESTING_BASE_URL=replace_with_test_apex_url
APEX_TESTING_WORKSPACE=replace_with_test_workspace
APEX_TESTING_USER=replace_with_test_apex_user
APEX_TESTING_PASSWORD=replace_with_test_apex_password

# ── APEX App Builder — production (fill only with explicit authorization) ─
# APEX_PRODUCTION_BASE_URL=replace_with_production_apex_url
# APEX_PRODUCTION_WORKSPACE=replace_with_production_workspace
# APEX_PRODUCTION_USER=replace_with_production_apex_user
# APEX_PRODUCTION_PASSWORD=replace_with_production_apex_password
