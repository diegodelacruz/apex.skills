# Template only. Never commit real credentials.
# Copy this file to .env in the repository root and replace every placeholder.
# .env is ignored by Git and is the only credential source for all local MCP routes.

# Select the database profile to use: production or testing
DB_ENV=testing

# Oracle — production
# DB_PRODUCTION_USER=replace_with_production_user
# DB_PRODUCTION_PASSWORD=replace_with_production_password
# DB_PRODUCTION_HOST=replace_with_production_host
# DB_PRODUCTION_PORT=1521
# DB_PRODUCTION_SID=replace_with_production_service
# Optional metadata cache for the managed apex-mcp wrapper. The wrapper discovers
# these values from Oracle when they are omitted.
# DB_PRODUCTION_WORKSPACE_ID=
# DB_PRODUCTION_SCHEMA=
# DB_PRODUCTION_WORKSPACE_NAME=

# ── APEX App Builder — production ────────────────────────────────────
# APEX_PRODUCTION_BASE_URL=http://sistemas.zaimella.com:8080/apex/
# APEX_PRODUCTION_WORKSPACE=de
# APEX_PRODUCTION_USER=replace_with_production_apex_user
# APEX_PRODUCTION_PASSWORD=replace_with_production_apex_password

# Oracle — testing
DB_TESTING_USER=replace_with_test_user
DB_TESTING_PASSWORD=replace_with_test_password
DB_TESTING_HOST=zaitestdb.zaimella.com
DB_TESTING_PORT=1523
DB_TESTING_SID=zaitest
# Optional metadata cache for the managed apex-mcp wrapper.
# DB_TESTING_WORKSPACE_ID=
# DB_TESTING_SCHEMA=
# DB_TESTING_WORKSPACE_NAME=

# ── APEX App Builder — testing ───────────────────────────────────────
APEX_TESTING_BASE_URL=http://sistemas.zaimella.com:8090/apex/
APEX_TESTING_WORKSPACE=de
APEX_TESTING_USER=replace_with_test_apex_user
APEX_TESTING_PASSWORD=replace_with_test_apex_password
